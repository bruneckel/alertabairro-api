# Copie para .env e ajuste. O .env nunca vai para o Git.
#
#   cp .env.example .env

# --- Oracle local (docker compose) ---
ORACLE_SYS_PASSWORD=oracle_sys_dev
APP_USER=alertabairro
APP_USER_PASSWORD=alertabairro_dev
ORACLE_SERVICO=FREEPDB1

# --- API ---
# Segredo de assinatura do JWT, no minimo 32 caracteres. Para gerar:
#   openssl rand -hex 48
# A API se recusa a subir sem ele.
JWT_SECRET=troque-por-um-segredo-com-no-minimo-32-caracteres

# Teto do pool de conexoes Oracle
POOL_MAX=10
