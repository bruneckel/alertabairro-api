<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Spring Boot 3.5.16: a ultima da linha 3.5.
    O estavel atual do start.spring.io e o 4.1.2, mas o Boot 4 renomeou os
    starters (spring-boot-starter-webmvc em vez de -web, entre outros) e a
    entrega tem prazo curto. Ficar na geracao 3.5, ainda suportada, troca
    novidade por previsibilidade. Decisao registrada no ledger do plano.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>br.com.fiap</groupId>
  <artifactId>alertabairro-api</artifactId>
  <version>1.0.0</version>
  <name>alertabairro-api</name>
  <description>API REST do AlertaBairro - Global Solution 2 2026</description>

  <properties>
    <java.version>21</java.version>
    <!-- 2.8.x e a linha do springdoc feita para o Boot 3.4/3.5 -->
    <springdoc.version>2.8.17</springdoc.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!--
      JDBC, nao JPA. O projeto e PL/SQL-centrico: JPA abstrai exatamente o que
      precisa de controle aqui (chamada de procedure, bind de parametro OUT,
      SQL explicito). Com JdbcClient e SimpleJdbcCall o SQL fica visivel.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <!--
      Resource server: a validacao de assinatura, expiracao e algoritmo do JWT
      vem da biblioteca (NimbusJwtDecoder), nao de codigo nosso.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Migracao versionada. Versoes vem da BOM do Boot (Flyway 11.7.2). -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-oracle</artifactId>
    </dependency>

    <!-- Driver thin: nao exige Oracle Instant Client. Versao da BOM (23.7). -->
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc11</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Swagger UI: e o que torna demonstraveis, no video, as rotas que o app nao usa. -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Banco proprio para os testes de integracao. Antes eles escreviam no mesmo Oracle
      que o app e o video usam, e passaram a dominar /indicadores e a lista do Mapa.
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>oracle-free</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!--
        Separacao que sustenta a mitigacao de risco da spec secao 11:
        classe *Test e unitaria e roda em "mvnw test", SEM banco e sem Docker.
        Classe *IT precisa de banco e roda em "mvnw verify", pelo failsafe.
        Assim quem nao tem Docker ainda consegue rodar parte da suite.
      -->
      <!--
        Segredo de teste para todas as suites. O SecurityConfig se recusa a subir
        sem um segredo de 32 caracteres (falhar na subida vale mais do que
        descobrir um segredo fraco em producao), entao qualquer @SpringBootTest
        precisa de um. Injetar aqui evita repetir @TestPropertySource em cada
        classe, e deixa claro que este valor existe so para teste.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <alertabairro.jwt.segredo>segredo-de-teste-com-mais-de-trinta-e-dois-caracteres</alertabairro.jwt.segredo>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <alertabairro.jwt.segredo>segredo-de-teste-com-mais-de-trinta-e-dois-caracteres</alertabairro.jwt.segredo>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
